# NextPlay Nexus — Environment Variables Template
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it contains real secrets.

# Database (see src/lib/db.ts + docs/db-schema.sql) — free tier, e.g. Neon
# (neon.tech, Vercel's own recommended Postgres; Storage tab on the Vercel
# project auto-wires this). Moved off Supabase for data storage after the
# Supabase org's billing suspension blocked provisioning a project at all.
DATABASE_URL=your_postgres_connection_string

# Supabase — kept for Auth only (login/signup, src/proxy.ts). Not currently
# provisioned; the app runs fine without these set (see src/proxy.ts —
# missing config degrades to "no session" rather than crashing, so public
# pages/API routes are unaffected either way).
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Email (Resend)
RESEND_API_KEY=your_resend_api_key
DEMO_NOTIFICATION_EMAIL=your_notification_email

# dotenvx encryption (optional — public key only, safe to share)
# DOTENV_PUBLIC_KEY_LOCAL=your_public_key
